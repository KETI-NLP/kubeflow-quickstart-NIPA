# Copy this file to configs/local.env and adjust the paths for your machine.
# The launcher loads configs/local.env for --profile local.

PYTHON_BIN=python

MODEL_PATH=/absolute/path/to/local/model_or_checkpoint
MODEL_ID=qwen3_5_9b_multimodal_sft_local
BASE_MODEL_NAME=Qwen/Qwen3.5-9B
PROCESSOR_PATH=
CHECKPOINTS_ROOT=/absolute/path/to/local/checkpoints_root
# Optional JSON list for explicit model choices in the chat UI.
# Example: configs/local_compare_models.json
MODELS_CONFIG=
HOST=127.0.0.1
PORT=8000
TORCH_DTYPE=bfloat16
# eager is safer on mixed local environments. Change to flash_attention_2 if your setup supports it.
ATTN_IMPLEMENTATION=eager

OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=dummy
TASKS='lighteval|gsm8k|0|0'
LIGHEVAL_OUTPUT_DIR=./lighteval_results_local

CHECKPOINTS_DIR=/absolute/path/to/local/checkpoints_root
CHECKPOINT_EVAL_OUTPUT_DIR=/absolute/path/to/local/eval_results/math_eval
PARALLEL_CHECKPOINT_EVAL_OUTPUT_DIR=/absolute/path/to/local/eval_results/math_eval_parallel
CHECKPOINT_SUMMARY_OUTPUT_PREFIX=parallel_summary
CHECKPOINT_GLOB=checkpoint-*
CHECKPOINT_LIMIT=
QUESTIONS_FILE=

# Used by the single-checkpoint local prompt-grid evaluator.
PROMPT_GRID_CHECKPOINT_DIR=/absolute/path/to/local/checkpoints_root/checkpoint-780
PROMPT_GRID_OUTPUT_DIR=/absolute/path/to/local/eval_results/prompt_grid
PROMPT_GRID_RANKING_FILE=
