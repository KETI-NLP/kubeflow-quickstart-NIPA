# Shared launcher profile for Kubernetes / Kubeflow usage.

PYTHON_BIN=python

MODEL_PATH=/data/checkpoints/qwen3_5_9b_multimodal_sft
MODEL_ID=qwen3_5_9b_multimodal_sft
BASE_MODEL_NAME=Qwen/Qwen3.5-9B
PROCESSOR_PATH=
CHECKPOINTS_ROOT=/data/checkpoints
MODELS_CONFIG=
HOST=0.0.0.0
PORT=8000
TORCH_DTYPE=bfloat16
ATTN_IMPLEMENTATION=flash_attention_2

NAMESPACE=gpu-workspace
SERVICE_NAME=vlm-qwen3-5-serve
LOCAL_PORT=8000
REMOTE_PORT=8000
K8S_SERVE_YAML=2_serve_vlm_qwen3_5.yaml

OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=dummy
TASKS='lighteval|gsm8k|0|0'
LIGHEVAL_OUTPUT_DIR=./lighteval_results

CHECKPOINTS_DIR=/data/checkpoints/qwen3_5_9b_multimodal_sft_lr_1e-5
CHECKPOINT_EVAL_OUTPUT_DIR=/data/eval_results/qwen3_5_9b_multimodal_sft_lr_1e-5_math_eval
PARALLEL_CHECKPOINT_EVAL_OUTPUT_DIR=/data/eval_results/qwen3_5_9b_multimodal_sft_lr_1e-5_math_eval_parallel
CHECKPOINT_SUMMARY_OUTPUT_PREFIX=parallel_summary
CHECKPOINT_GLOB=checkpoint-*
CHECKPOINT_LIMIT=
QUESTIONS_FILE=
K8S_CHECKPOINT_EVAL_TEMPLATE=7_eval_single_checkpoint_job.yaml

PROMPT_GRID_CHECKPOINT_DIR=
PROMPT_GRID_OUTPUT_DIR=/data/eval_results/qwen3_5_9b_multimodal_sft_lr_1e-5_prompt_grid_parallel
PROMPT_GRID_RANKING_FILE=
K8S_PROMPT_GRID_TEMPLATE=12_eval_single_checkpoint_prompt_job.yaml
CHECKPOINTS=checkpoint-300 checkpoint-500 checkpoint-600 checkpoint-700 checkpoint-780
